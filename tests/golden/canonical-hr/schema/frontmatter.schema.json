{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "domain": {
      "enum": [
        "portfolio",
        "product",
        "technical"
      ]
    },
    "entities": {
      "items": {
        "pattern": "^(prd|cmp|ver|cus):[a-z0-9.-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "review_by": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "enum": [
        "current",
        "superseded"
      ]
    },
    "superseded_by": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "enum": [
        "adr",
        "glossary",
        "guide",
        "requirement",
        "spec"
      ]
    }
  },
  "required": [
    "domain",
    "id",
    "review_by",
    "title",
    "type"
  ],
  "title": "knowledge-hub frontmatter",
  "type": "object",
  "x-forbidden-keys": [
    "tier",
    "audience",
    "audiences",
    "required_audiences",
    "allowed_emails",
    "visibility",
    "approved_by",
    "approved_at",
    "generated_by",
    "derived_from"
  ]
}
